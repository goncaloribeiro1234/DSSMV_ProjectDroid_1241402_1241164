<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.lojadevideojogos">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LojaDeVideoJogos">

        <!-- WelcomeActivity agora é o ecrã inicial (Launcher) -->
        <activity
            android:name=".views.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A MainActivity antiga deixa de ser a Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- NOVA: Ecrã da Loja Principal -->
        <activity
            android:name=".views.StoreActivity"
            android:exported="false" />

        <!-- NOVA: Ecrã de Detalhes do Jogo -->
        <activity
            android:name=".views.GameDetailActivity"
            android:exported="false" />

    </application>
</manifest>