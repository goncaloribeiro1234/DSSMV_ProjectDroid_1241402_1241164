<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gamehub_background_dark">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Capa do Jogo em Grande -->
        <ImageView
            android:id="@+id/ivCoverDetail"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:background="#333333"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título do Jogo -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Título do Jogo"
            android:textColor="@color/gamehub_text_light"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivCoverDetail" />

        <!-- Descrição Fictícia -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Esta é a descrição detalhada do jogo. Na próxima fase, esta informação virá da base de dados RestDB ou da RAWG. Por agora, é apenas um placeholder visual para a interface gráfica profissional."
            android:textColor="@color/gamehub_text_gray"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDetailTitle" />

        <!-- Botão Cliente (Comprar/Pedir) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuy"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:text="Pedir Adição ao Catálogo"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvDetailDescription" />

        <!-- Botão Gestor (Editar Preço) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:text="Editar Preço / Jogo"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnBuy" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>